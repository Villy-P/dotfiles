{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": [],
    "modules-center": ["clock"],
    "modules-right": ["custom/btop", "network", "pulseaudio"],

    "clock": {
        "format": "{:%I:%M %p   %A, %B %d}",
        "on-click": "kitty --class float-tui-t -e calcure"
    },

    "network": {
        "format-wifi": "  ",
        "format-ethernet": "  {ifname}",
        "format-disconnected": "󰤭",
        "tooltip-format": "{ifname} via {gwaddr}\n{essid} ({signalStrength}%)",
        "on-click": "kitty --class float-tui-tr -e wifitui"
    },

    "custom/btop": {
        "format": "  ",
        "on-click": "kitty --class float-tui-fs -e btop"
    },

    "pulseaudio": {
        "format": "{icon}  ",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "Volume: {volume}%",
        "on-click": "kitty --class float-tui-tr-wide -e pulsemixer",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    }
}