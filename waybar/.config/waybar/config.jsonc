{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["custom/btop"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio"],

    "clock": {
        "format": "{:%I:%M %p   %A, %B %d}",
        "on-click": "kitty --class float-tui-t -e calcure"
    },

    "network": {
        "format-wifi": "  {essid} ({signalStrength}%)",
        "format-ethernet": "  {ifname}",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "kitty --class float-tui-tr -e wifitui"
    },

    "custom/btop": {
        "format": "  ",
        "on-click": "kitty --class float-tui-fs -e btop"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "🔇 Muted",
        "format-icons": {
            "headphone": "🎧",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    }
}