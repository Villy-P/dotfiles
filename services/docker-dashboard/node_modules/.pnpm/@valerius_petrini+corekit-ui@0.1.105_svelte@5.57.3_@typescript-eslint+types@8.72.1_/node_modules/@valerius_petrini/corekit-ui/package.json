{
	"name": "@valerius_petrini/corekit-ui",
	"version": "0.1.105",
	"description": "Component Library used across all my projects",
	"author": "Valerius Petrini Jr.",
	"license": "MIT",
	"scripts": {
		"dev": "storybook dev -p 6006",
		"build": "svelte-package -i src/lib && publint",
		"prepack": "svelte-package -i src/lib && publint",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"storybook": "storybook dev -p 6006",
		"updatenpm": "npm version patch && git push origin HEAD --follow-tags",
		"build-storybook": "storybook build",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./layout.css": "./dist/styles/layout.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.4.4",
		"@storybook/addon-docs": "^10.4.4",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.4.4",
		"@storybook/svelte-vite": "^10.4.4",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bytes": "^3.1.5",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.5",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.17",
		"storybook": "^10.4.4",
		"storybook-dark-mode": "^5.0.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^7.3.1",
		"vitest": "^4.1.5"
	},
	"keywords": [
		"components",
		"svelte"
	],
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"@lucide/svelte": "^1.3.0",
		"@valerius_petrini/corekit-scripts": "^1.0.0",
		"bytes": "^3.1.2",
		"tailwind-merge": "^3.5.0"
	}
}
