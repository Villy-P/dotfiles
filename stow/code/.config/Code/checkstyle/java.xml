<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org">

<module name="Checker">
    <module name="TreeWalker">
        <!-- Disable all magic numbers -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
        </module>

        <!-- Limit method length to 25 lines -->
        <module name="MethodLength">
            <property name="max" value="25"/>
        </module>

        <!-- Require descriptive variable names -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{2,}$"/>
            <property name="allowOneCharVarInForLoop" value="true"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{2,}$"/>
        </module>

        <!-- Disable wildcard imports -->
        <module name="AvoidStarImport"/>

        <!-- Enforce whitespace around binary operations -->
        <module name="WhitespaceAround">
            <property name="tokens" value="PLUS, MINUS, STAR, DIV, MOD, EQUAL, NOT_EQUAL, GT, GE, LT, LE, LAND, LOR, BAND, BOR, BXOR"/>
        </module>

        <!-- Enforce braces on every block -->
        <module name="NeedBraces"/>

        <!-- Disable writing == true -->
        <module name="SimplifyBooleanExpression"/> 
    </module>
</module>